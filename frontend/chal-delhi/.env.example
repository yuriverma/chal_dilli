# Copy to .env.local for local dev, or set these in Netlify/Vercel/Cloudflare
# build environment variables. Vite inlines them at build time.

# Python backend (chat + routing + food + events)
VITE_BRAIN_API_URL=http://127.0.0.1:8000

# Auth/user service. Leave EMPTY to run the app without login —
# the chat works fine without it.
VITE_AUTH_API_URL=

# Optional: override the pages scraped for events
# VITE_NON_TECH_EVENTS_URL=https://in.bookmyshow.com/explore/events-delhi-ncr
# VITE_TECH_EVENTS_URL=https://unstop.com/hackathons?filters=open
