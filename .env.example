# Copy to .env for local dev, or set these in your host's dashboard.
# NEVER commit the real .env — it is gitignored.

# --- Parse.bot (events) ---
# The old key cbd3aaa1-... was committed to a public repo. Rotate it.
# If unset, the two /api/parse-*events* endpoints return 503 and the rest of
# the app works normally.
PARSEBOT_API_KEY=
# Optional, only if the technical-events scraper uses a different key:
PARSEBOT_TECH_API_KEY=

# --- CORS ---
# Comma-separated frontend origins. Leave unset (or "*") for open access
# without credentials.
# ALLOWED_ORIGINS=https://your-frontend.netlify.app,http://localhost:5173

# --- Admin ---
# Required to enable POST /update-data. If unset, that endpoint 404s.
ADMIN_TOKEN=

# --- Server ---
PORT=8000
